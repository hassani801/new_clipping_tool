# =============================================================================
# NestJS backend — environment variables
# Copy to .env and fill in secrets.
# =============================================================================

NODE_ENV=development
PORT=3001

# SQLite database file path (canonical). DB_DATABASE is accepted as fallback.
DATABASE_PATH=db.sqlite

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=24h

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Python processing service
PYTHON_SERVICE_URL=http://127.0.0.1:8001
# Must match PYTHON_ENGINE_SECRET in python-service/.env
PYTHON_ENGINE_SECRET=change-me-secret-token

# Tier limits
FREE_TIER_MAX_DURATION_SECONDS=600
FREE_TIER_MAX_CLIPS=3
FREE_TIER_DAILY_JOB_CAP=2
PAID_TIER_MAX_DURATION_SECONDS=1800
PAID_TIER_MAX_CLIPS=10
PAID_TIER_DAILY_JOB_CAP=50
