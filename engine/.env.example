# =============================================================================
# OpenShorts / clipping engine — environment variables
# Copy to .env and fill in secrets. All values below are read from code.
# =============================================================================

# --- Required for moment detection / layout AI --------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# off | low | medium | high — thinking budget for Gemini scoring
GEMINI_THINKING_SCORE=off

# --- Transcription ------------------------------------------------------------
# faster_whisper (default) | deepgram
TRANSCRIPT_PROVIDER=faster_whisper
DEEPGRAM_API_KEY=
# whisper | onnx_asr (advanced)
TRANSCRIBE_BACKEND=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_BEAM_SIZE=2
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1
ASR_GPU_CONCURRENCY=1

# --- Encoding / audio ---------------------------------------------------------
# x264 | nvenc | ...
FFMPEG_ENCODER=x264
# 1 = loudnorm, 0 = off
AUDIO_NORMALIZE=1

# --- Clip count / duration targets --------------------------------------------
# CLIP_TARGET_MIN=3
# CLIP_TARGET_MAX=3
# CLIP_MIN_SECONDS=15
# CLIP_MAX_SECONDS=60
CLIP_WORKERS=3

# --- Download / network -------------------------------------------------------
# YOUTUBE_COOKIES=/path/to/cookies.txt
# PROXY_URL=
# STATIC_PROXY_URLS=
# BGUTIL_BASE_URL=
# BGUTIL_SCRIPT_PATH=
# DIRECT_FIRST=0

# --- Detection / YOLO / scenes ------------------------------------------------
YOLO_MODEL_PATH=yolov8n.pt
JUMP_CONFIRM_FRAMES=3
SCENE_CUT_RESET=1
DETECT_STRIDE=4
SCENE_ENGINE=transnetv2
TRANSNETV2_DEVICE=auto
TRANSNETV2_THRESHOLD=0.5
SCENE_MIN_SEC=0.4

# --- Reframe / layout ---------------------------------------------------------
REFRAME_ENGINE=v2
GENERAL_CONTENT_HEIGHT_RATIO=0.42
# AUTO_LAYOUT: 0 | 1 | gemini | heuristic
AUTO_LAYOUT=0
LAYOUT_SAMPLE_FRAMES=12
LAYOUT_SAMPLE_WIDTH=1024
SPLIT_LAYOUT=0
SPLIT_TIGHTNESS=0.8
SPLIT_MIN_SHARE=0.2
SCREENCAST_LAYOUT=0
PUNCH_IN=0
PUNCH_IN_ZOOM=1.12
INSET_PADDING=1.45
SPEAKER_SIGNAL=0
SPEAKER_CUT=0

# --- Captions / hooks / watermark ---------------------------------------------
AUTO_CAPTIONS=1
AUTO_HOOK=0
AUTO_HOOK_STYLE=classic
AUTO_HOOK_SECONDS=5
WATERMARK=0

# --- Speech gates -------------------------------------------------------------
MIN_SPEECH_WORDS_PER_MIN=5
MIN_SPEECH_WORDS=8
