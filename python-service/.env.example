# =============================================================================
# python-service (FastAPI orchestrator) — environment variables
# Copy to .env and fill in secrets. Values match app/config.py + pass-throughs.
# =============================================================================

# --- Core ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
# Aliases also accepted: PYTHON_PORT, PYTHON_ENGINE_PORT
STAGE_NAME=local
ENGINE_TYPE=openshort
PYTHON_ENGINE_SECRET=change-me-secret-token

# Absolute path to engine/ (contains main.py). Docker default: /app/engine
OPENSHORT_ROOT=
# Interpreter used to spawn engine/main.py (defaults to this process's Python)
OPENSHORT_PYTHON=

# NestJS backend internal URL for job-result callbacks (canonical name).
BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# Storage
STORAGE_ROOT=../storage
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8001
MAX_CONCURRENT_JOBS=1
CLIP_WORKERS=2

# Gemini (passed through to engine subprocess)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Download limits
YTDLP_MAX_HEIGHT=1080
MAX_SOURCE_VIDEO_DURATION_SECONDS=10800

# --- Tier (local stub; Nest passes tier per request) --------------------------
# Legacy seed list — only honoured when DEV_ALLOW_PAID_USER_IDS=1.
# NEVER set in production; tier is authoritative from the Nest request body.
DEV_ALLOW_PAID_USER_IDS=0
PAID_USER_IDS=
# Canonical names match NestJS backend. Used as fallback when not sent per-request.
FREE_TIER_DAILY_JOB_CAP=2
FREE_TIER_MAX_DURATION_SECONDS=600
PAID_TIER_MAX_DURATION_SECONDS=1800

# --- Transcription pass-through to engine -------------------------------------
# TRANSCRIPT_PROVIDER=faster_whisper
# DEEPGRAM_API_KEY=
# TRANSCRIBE_BACKEND=whisper
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8
# WHISPER_BEAM_SIZE=2
# WHISPER_CPU_THREADS=4
# WHISPER_NUM_WORKERS=1
# AUTO_HOOK=0
# AUTO_HOOK_STYLE=classic
# REFRAME_ENGINE=v2
# DETECT_STRIDE=4
# SCENE_ENGINE=pyscenedetect
# GENERAL_CONTENT_HEIGHT_RATIO=0.42
# FFMPEG_ENCODER=x264
# AUTO_CAPTIONS=1

# --- S3 (only when STORAGE_BACKEND=s3) ----------------------------------------
# STORAGE_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
